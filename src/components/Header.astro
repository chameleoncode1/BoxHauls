---
// Map §10 header rule: Logo -> /; Pricing; Services dropdown (five hubs);
// How it works; Trust; Get the app. The driver link never appears in the
// header on rider pages (footer only, map §2). Driver-template pages get
// a single "For customers" link back to / instead of the rider nav —
// audience isolation is structural, not a copy choice.
//
// Wordmark is real text (not baked into the logo image) — two-tone
// black/red matching src/assets/logo.png, but crisp at any size and
// readable by screen readers/search engines without alt-text tricks.
import { Image } from "astro:assets";
import logoIcon from "../assets/logo-icon.png";
import type { SitemapEntry } from "../lib/sitemap";

interface Props {
  entry: SitemapEntry;
}

const { entry } = Astro.props;
const isDriver = entry.template === "driver";

const serviceHubs = [
  ["/services/furniture-delivery/", "Furniture & Large-Item Delivery"],
  ["/services/small-moves/", "Small Moves"],
  ["/services/appliance-delivery/", "Appliance Delivery & Haul-Away"],
  ["/services/junk-removal/", "Junk Removal & Dump Runs"],
  ["/services/business-hauling/", "Business & Jobsite Hauling"],
] as const;
---

<header class="border-b-2 border-accent">
  <div class="mx-auto max-w-container px-4 py-3 flex items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-2 shrink-0">
      <Image src={logoIcon} alt="" width={40} height={25} class="h-9 w-auto" />
      <span class="font-extrabold text-xl tracking-tight">
        <span class="text-text">Box</span><span class="text-accent">Hauls</span>
      </span>
    </a>

    {isDriver ? (
      <a class="text-sm font-semibold underline decoration-accent" href="/">For customers</a>
    ) : (
      <nav aria-label="Primary" class="hidden md:flex items-center gap-6 text-sm font-medium">
        <a class="hover:text-accent" href="/pricing/">Pricing</a>

        <div class="relative group">
          <button type="button" class="inline-flex items-center gap-1 hover:text-accent" aria-haspopup="true">
            Services
          </button>
          <ul
            class="absolute left-0 top-full hidden group-hover:block group-focus-within:block bg-bg border border-border rounded-md p-2 min-w-[16rem] shadow-md z-10"
          >
            {serviceHubs.map(([href, label]) => (
              <li>
                <a class="block px-2 py-1.5 rounded-sm hover:bg-surface hover:text-accent" href={href}>{label}</a>
              </li>
            ))}
          </ul>
        </div>

        <a class="hover:text-accent" href="/how-it-works/">How it works</a>
        <a class="hover:text-accent" href="/trust/">Trust</a>
        <a
          class="rounded-md bg-accent px-4 py-2 text-accent-foreground hover:bg-accent-hover"
          href="/app/"
        >
          Get the app
        </a>
      </nav>
    )}
  </div>
</header>
