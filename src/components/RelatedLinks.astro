---
// Map §10: "3-5 links chosen per page from the same cluster; never
// sitewide; never the homepage."
import { getResolvedCluster, type SitemapEntry } from "../lib/sitemap";
import { substitute } from "../lib/placeholders";

interface Props {
  entry: SitemapEntry;
  max?: number;
}

const { entry, max = 5 } = Astro.props;

// "never the homepage" (map §10) reads as: the homepage never gets a
// generic Related module (it's already the top of the hierarchy), and
// "/" is never offered as a suggested link on any other page.
const isHome = entry.url === "/";

// Pick neighbors relative to this page's own position in the cluster
// (a ring, wrapping around), not a fixed slice(0, max) — a fixed prefix
// would return the identical set for every page in the cluster, which
// both defeats the point of "related" and means pages later in the
// cluster's array order can never be suggested by anyone (an orphan risk
// npm run qa's click-graph check catches).
const clusterPages = getResolvedCluster(entry.cluster).filter((p) => p.url !== "/");
const selfIndex = clusterPages.findIndex((p) => p.url === entry.url);

const related = isHome || selfIndex === -1
  ? []
  : Array.from({ length: Math.min(max, clusterPages.length - 1) }, (_, i) => {
      const offset = Math.ceil((i + 1) / 2) * (i % 2 === 0 ? 1 : -1); // +1, -1, +2, -2, +3, ...
      const idx = (selfIndex + offset + clusterPages.length) % clusterPages.length;
      return clusterPages[idx];
    }).filter((p, i, arr) => arr.findIndex((q) => q.url === p.url) === i); // de-dupe on wraparound
---

{related.length > 0 && (
  <nav aria-label="Related" class="mt-8">
    <h2 class="text-lg font-semibold mb-2">Related</h2>
    <ul class="list-disc pl-5 space-y-1">
      {related.map((p) => (
        <li>
          <a class="text-accent underline" href={p.url}>{substitute(p.h1, p.url)}</a>
        </li>
      ))}
    </ul>
  </nav>
)}
