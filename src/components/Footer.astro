---
// Map §10 footer rule: <=12 links (five hubs, /pricing/, /trust/,
// /cities/, /guides/, /drive/, /partners/, /contact/) + NAP + app badges,
// nothing else — for rider pages. Driver pages get a distinct, smaller
// footer instead of reusing this list: CLAUDE.md #7 / map §2 forbid
// driver pages linking to /services/ or /pricing/, and the rider footer
// is exactly that list, so it can't be reused as-is for the /drive/
// audience.
//
// Black background with white/red text — matches the logo's own
// black+red banner treatment (src/assets/logo.png). Text-only wordmark
// here rather than the icon: the icon PNG has an opaque white
// background baked in (its box-face and chrome-highlight elements are
// the same near-white as the true background, so they can't be reliably
// separated into transparency), which would show as an ugly white box
// on this dark footer. The header uses the icon on its light background,
// where that's a non-issue.
import type { SitemapEntry } from "../lib/sitemap";
import { substitute } from "../lib/placeholders";

interface Props {
  entry: SitemapEntry;
}

const { entry } = Astro.props;
const isDriver = entry.template === "driver";

const riderLinks = [
  ["/services/furniture-delivery/", "Furniture & Large-Item Delivery"],
  ["/services/small-moves/", "Small Moves"],
  ["/services/appliance-delivery/", "Appliance Delivery & Haul-Away"],
  ["/services/junk-removal/", "Junk Removal & Dump Runs"],
  ["/services/business-hauling/", "Business & Jobsite Hauling"],
  ["/pricing/", "Pricing"],
  ["/trust/", "Trust & Safety"],
  ["/cities/", "Cities"],
  ["/guides/", "Guides"],
  ["/drive/", "Drive for BoxHauls"],
  ["/partners/", "Partners"],
  ["/contact/", "Contact"],
] as const;

const driverLinks = [
  ["/drive/requirements/", "Requirements"],
  ["/drive/earnings/", "Earnings"],
  ["/drive/equipment/", "Equipment"],
  ["/drive/safety/", "Safety"],
  ["/drive/faq/", "Driver FAQ"],
  ["/drive/apply/", "Apply to drive"],
  ["/legal/driver-agreement/", "Driver agreement"],
  ["/contact/", "Contact"],
] as const;

const links = isDriver ? driverLinks : riderLinks;
const nap = substitute("{{LEGAL_NAME}} · {{ADDRESS}} · {{PHONE}}", entry.url);
---

<footer class="mt-16 bg-inverse-bg text-inverse-text">
  <div class="mx-auto max-w-container px-4 py-12">
    <a href="/" class="inline-block font-extrabold text-lg tracking-tight mb-8">
      <span class="text-inverse-text">Box</span><span class="text-accent">Hauls</span>
    </a>

    <nav aria-label="Footer" class="grid grid-cols-2 sm:grid-cols-3 gap-x-4 gap-y-2 mb-8 text-sm">
      {links.map(([href, label]) => (
        <a class="text-inverse-text-muted hover:text-accent" href={href}>{label}</a>
      ))}
    </nav>

    <div class="border-t border-inverse-border pt-6 text-sm text-inverse-text-muted space-y-2">
      <p>{nap}</p>
      <p>
        <a class="text-accent hover:text-inverse-text" href="/app/">Get the app</a>
      </p>
    </div>
  </div>
</footer>
