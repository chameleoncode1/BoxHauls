---
// Shared shell for every template layout (docs/PLAN.md §1). Real content
// (src/content/pages/*.mdx) takes over the body once it exists for a
// page; until then the content_blocks stub shows what's still needed.
// Header/footer, breadcrumbs, JSON-LD, and linking are structural and
// render the same either way.
import "../styles/global.css";
import { substitute, substituteBrackets } from "../lib/placeholders";
import { getMeta } from "../lib/meta";
import { buildSchema, type SchemaContent } from "../lib/schema";
import { getPageContent } from "../lib/content";
import { renderInlineMarkdown } from "../lib/markdown";
import type { SitemapEntry } from "../lib/sitemap";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import BodyLinks from "../components/BodyLinks.astro";
import RelatedLinks from "../components/RelatedLinks.astro";
import Analytics from "../components/Analytics.astro";

interface Props {
  entry: SitemapEntry;
  template: string;
}

const { entry, template } = Astro.props;
const h1 = substitute(entry.h1, entry.url);
const contentBlocks = substitute(entry.content_blocks, entry.url);
const canonical = new URL(entry.url, "https://boxhauls.com").toString();
const meta = getMeta(entry);
const pageContent = await getPageContent(entry.url);
const { Content } = pageContent ?? {};

// Frontmatter (faqs/howToSteps/author) is plain YAML, not run through
// the MDX/remark pipeline, so [[TOKENS]] in it are never substituted
// there — resolve it once here for both display and the JSON-LD below,
// so the two can't disagree (map §9 rule 7: FAQPage schema must mirror
// the on-page text exactly).
const rawData = pageContent?.entry.data;
const data: SchemaContent | undefined = rawData && {
  faqs: rawData.faqs?.map((f) => ({
    question: substituteBrackets(f.question, entry.url),
    answer: substituteBrackets(f.answer, entry.url),
  })),
  howToSteps: rawData.howToSteps?.map((s) => ({
    name: substituteBrackets(s.name, entry.url),
    text: substituteBrackets(s.text, entry.url),
  })),
  author: rawData.author ? substituteBrackets(rawData.author, entry.url) : undefined,
  updated: rawData.updated,
};
const schema = buildSchema(entry, data);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="BoxHauls" />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={meta.ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />
    <meta name="twitter:image" content={meta.ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
    <Analytics />
  </head>
  <body>
    <Header entry={entry} />

    <main class="mx-auto max-w-container px-4 py-12">
      <Breadcrumbs url={entry.url} />

      <h1 class="text-4xl font-bold leading-tight mb-6">{h1}</h1>

      {Content ? (
        <>
          <article class="prose mb-8">
            <Content />
          </article>

          {data?.howToSteps && data.howToSteps.length > 0 && (
            <section class="mb-8">
              <h2 class="text-2xl font-semibold mb-4">Steps</h2>
              <ol class="list-decimal pl-5 space-y-3">
                {data.howToSteps.map((step) => (
                  <li>
                    <strong set:html={renderInlineMarkdown(step.name)} /> — <span set:html={renderInlineMarkdown(step.text)} />
                  </li>
                ))}
              </ol>
            </section>
          )}

          {data?.faqs && data.faqs.length > 0 && (
            <section class="mb-8">
              <h2 class="text-2xl font-semibold mb-4">Frequently asked questions</h2>
              <div class="space-y-6">
                {data.faqs.map((faq) => (
                  <div>
                    <h3 class="font-semibold mb-1" set:html={renderInlineMarkdown(faq.question)} />
                    <p class="text-text-muted" set:html={renderInlineMarkdown(faq.answer)} />
                  </div>
                ))}
              </div>
            </section>
          )}

          {(data?.author || data?.updated) && (
            <p class="text-sm text-text-muted mb-8">
              {data?.author}
              {data?.author && data?.updated && " · "}
              {data?.updated && `Facts checked ${data.updated}`}
            </p>
          )}
        </>
      ) : (
        <!-- qa:ignore-start — this box quotes docs/sitemap.json's own
             content_blocks planning text verbatim (e.g. "cargo insurance",
             "not freight"), not authored copy. npm run qa excludes it from
             the banned-phrase check for that reason; it disappears once
             this page gets a src/content/pages/*.mdx file. -->
        <>
          <p class="text-sm text-text-muted mb-2">
            Template: <strong>{template}</strong> · Phase {entry.phase} · Cluster: {entry.cluster} · {entry.page_type}
          </p>
          <section class="mb-8 rounded-md border border-border bg-surface p-4">
            <h2 class="text-lg font-semibold mb-2">Required content blocks</h2>
            <p class="text-text-muted whitespace-pre-wrap">{contentBlocks}</p>
          </section>
        </>
        <!-- qa:ignore-end -->
      )}

      <section class="mb-8">
        <h2 class="text-lg font-semibold mb-2">{Content ? "Learn more" : "Links to"}</h2>
        <BodyLinks links={entry.links_to} />
      </section>

      <slot />

      <RelatedLinks entry={entry} />
    </main>

    <Footer entry={entry} />
  </body>
</html>
